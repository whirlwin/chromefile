{
  "manifest_version": 3,
  "name": "Claude Browser Bridge",
  "version": "0.1.0",
  "description": "Lets a local Claude Code session control this browser.",
  "minimum_chrome_version": "135",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Claude Browser Bridge",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "commands": {
    "select-next-tab": {
      "suggested_key": {
        "default": "Alt+J",
        "mac": "Command+J"
      },
      "description": "Switch to the next tab"
    },
    "select-previous-tab": {
      "suggested_key": {
        "default": "Alt+K",
        "mac": "Command+K"
      },
      "description": "Switch to the previous tab"
    }
  },
  "permissions": [
    "nativeMessaging",
    "tabs",
    "tabGroups",
    "scripting",
    "debugger",
    "userScripts",
    "declarativeNetRequest",
    "cookies",
    "history",
    "bookmarks",
    "downloads",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
